# Copy to .env and fill in ONE provider key. Never commit .env.

# ---- LLM provider: openrouter | anthropic | openai | none
LLM_PROVIDER=openrouter

# OpenRouter (one key, many models; OpenAI-compatible API, supports images)
OPENROUTER_API_KEY=
# Must be a vision-capable model id from https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=800

# ---- RAG
# auto = Sentence Transformers if it loads, otherwise TF-IDF character n-grams
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
# Set to true ONLY after the store owner confirms data/knowledge_draft_additions.json
KB_INCLUDE_DRAFTS=false

# ---- Booking requests
# Password for the staff page http://localhost:8000/admin (leave empty to disable it)
ADMIN_TOKEN=
BOOKINGS_DB=data/bookings.db
# How many requests one hourly slot can hold (e.g. number of groomers). Default 1.
BOOKING_SLOT_CAPACITY=1
# Cat size / coat surcharges used by the cat photo estimate
CAT_PRICING_PATH=data/cat_pricing.json

# ---- Limits
MAX_MESSAGE_CHARS=1000
MAX_HISTORY_TURNS=8
MAX_IMAGE_MB=5
